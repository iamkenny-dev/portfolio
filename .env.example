# Copy this file to .env and fill it in. Never commit .env.

# The Gmail account that sends the messages
GMAIL_USER=you@gmail.com

# A 16-character Google app password, not your normal Gmail password
GMAIL_APP_PASSWORD=

# Where contact form messages are delivered
CONTACT_TO=you@gmail.com

# Set to 1 when hosted behind a proxy (Render, Railway, etc.)
# TRUST_PROXY=1
